# TMSI Equipment Price Listing — environment template
# Copy to .env and fill in. NEVER commit .env.

# ---- public URLs ----------------------------------------------------------
APP_DOMAIN=tmisequipment.duckdns.org
SITE_URL=https://tmisequipment.duckdns.org
# Supabase gateway (Kong) as seen from the browser; proxied under /supabase
NEXT_PUBLIC_SUPABASE_URL=https://tmisequipment.duckdns.org/supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-jwt-from-supabase-env

# ---- server-side only (never exposed to the browser) ----------------------
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-jwt-from-supabase-env
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/postgres

# ---- Supabase self-hosted (values live in deploy/supabase/.env; listed here
#      so both files stay in sync) -----------------------------------------
POSTGRES_PASSWORD=replace-me-long-random
JWT_SECRET=replace-me-at-least-32-chars-random
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace-me

# ---- SMTP for auth e-mails (password reset, invitations) -----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=TMSI Price Listing
SMTP_ADMIN_EMAIL=

# ---- DuckDNS (for the certificate / dynamic IP updater) ------------------
DUCKDNS_SUBDOMAIN=tmisequipment
DUCKDNS_TOKEN=
