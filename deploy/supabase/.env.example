# PROPRIETARY AND CONFIDENTIAL — unauthorised use, copying, modification or
# distribution is strictly prohibited. See LICENSE at the repository root.
#
# Every name here is the REAL name this stack's docker-compose.yml actually
# reads (verified against the live production .env, names only, 2026-09-06 —
# see docs/DISASTER-DRILL.md achado 6, which found the previous template at
# the repo root missing most of these). Copy this file to `.env` in this same
# directory (`deploy/supabase/.env`) and fill in every value — never commit
# the filled-in file (.gitignore already excludes it).
#
# Placeholders below are never realistic-looking secrets — always an obvious
# marker to replace, per house rule.

# ---- Postgres ---------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=REPLACE_ME_LONG_RANDOM

# ---- JWT (GoTrue + PostgREST both trust tokens signed with this) ------
JWT_SECRET=REPLACE_ME_AT_LEAST_32_RANDOM_CHARS
JWT_EXPIRY=3600
# Generated FROM JWT_SECRET (the standard Supabase self-hosted way: an HS256
# JWT with role "anon"/"service_role" and this JWT_SECRET). Regenerate both
# together whenever JWT_SECRET changes — see docs/DISASTER-DRILL.md, which
# proved bcrypt user password hashes stay valid across a JWT_SECRET rotation
# even though these two keys must be re-derived. ANON_KEY is also what
# docker-compose.yml passes to tmsi-app itself as SUPABASE_ANON_KEY (item
# 22) — one value, not duplicated across two .env keys.
ANON_KEY=REPLACE_ME_JWT_WITH_ROLE_ANON
SERVICE_ROLE_KEY=REPLACE_ME_JWT_WITH_ROLE_SERVICE_ROLE

# ---- Public URLs / GoTrue redirect allowlist ---------------------------
# The app's own public origin — no Kong, no /supabase prefix, nginx proxies
# auth/rest straight from the domain root. Also what docker-compose.yml
# passes to tmsi-app itself as SUPABASE_URL, read server-side at runtime
# (item 22, docs/DISASTER-DRILL.md achado 3 — no longer a NEXT_PUBLIC_*
# build-time value; see deploy/DEPLOY.md §3 for the history of that).
SITE_URL=https://REPLACE_ME.example.com
API_EXTERNAL_URL=https://REPLACE_ME.example.com
# GOTRUE_URI_ALLOW_LIST — glob pattern(s) GoTrue accepts as a redirect_to
# target (password recovery, invites). Reject-and-fall-back-to-SITE_URL for
# anything else — see app/src/app/forgot-password/actions.ts's own comment
# and docs/STATE.md's tarefa 7 for why this matters.
ADDITIONAL_REDIRECT_URLS=https://REPLACE_ME.example.com/**

# ---- GoTrue behaviour ---------------------------------------------------
DISABLE_SIGNUP=true
ENABLE_ANONYMOUS_USERS=false
# false in production: users are created by an admin (i9's invite flow), not
# self-registered, and never auto-confirmed on public signup. NOTE: this is
# distinct from the admin-forced reset path, which deliberately DOES pass
# email_confirm:true on that one call only — see admin/users/actions.ts.
ENABLE_EMAIL_AUTOCONFIRM=false
GOTRUE_MAILER_AUTOCONFIRM=false

# ---- GoTrue mailer (password recovery / invite emails) ------------------
GOTRUE_SMTP_HOST=REPLACE_ME
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_ADMIN_EMAIL=REPLACE_ME@example.com
# Our lean stack has no Kong stripping a path prefix in front of GoTrue —
# without these four, GoTrue's own default link paths ("/verify") 404
# through nginx, which only proxies /auth/v1/. Matches upstream Supabase's
# own .env.example for the same reason (see docker-compose.yml's own
# comment next to these). Never leave unset.
GOTRUE_MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_INVITE=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_RECOVERY=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
# Custom HTML templates (recovery/invite emails) — a URL GoTrue fetches at
# send time, not a local file path.
GOTRUE_MAILER_TEMPLATES_RECOVERY=REPLACE_ME_URL_OR_LEAVE_UNSET_FOR_DEFAULT
GOTRUE_MAILER_TEMPLATES_INVITE=REPLACE_ME_URL_OR_LEAVE_UNSET_FOR_DEFAULT

# ---- PostgREST -----------------------------------------------------------
# Exposes BOTH schemas — tmsi (the app's own) and public (extensions/shared
# helpers). Never widen this without checking what that schema's own RLS
# looks like first.
PGRST_DB_SCHEMAS=tmsi,public

# ---- Not in this file, deliberately ---------------------------------------
# GOTRUE_PASSWORD_MIN_LENGTH, GOTRUE_PASSWORD_REQUIRED_CHARACTERS,
# GOTRUE_SECURITY_UPDATE_PASSWORD_REQUIRE_CURRENT_PASSWORD, and the four
# nginx security headers are literal values in docker-compose.yml / the vhost
# respectively, not environment variables — nothing to fill in here for them.
# tmsi-app's own SUPABASE_URL/SUPABASE_ANON_KEY (item 22) aren't separate
# .env keys either — docker-compose.yml wires them straight from SITE_URL/
# ANON_KEY above, so there's exactly one place to update each value.
