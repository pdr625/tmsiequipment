#!/bin/bash
# commit-msg — a guarda que faltou a 2026-09-23.
#
# Falha o commit se um ficheiro de `docs/` perder mais de metade das linhas,
# a menos que a mensagem traga a palavra `rewrite`.
#
# PORQUÊ: nesse dia escrevi `docs/TEST-ACCOUNTS.md` com `cat >` a assumir que
# não existia. Existia — 105 linhas do levantamento de 19/09 sobre o que se
# perde ao desactivar as contas `.test` — e o commit apagou-as. O CLAUDE.md já
# mandava ler antes de escrever; a regra escrita não chegou, e por isso passa a
# haver uma verificação mecânica.
#
# PORQUÊ `commit-msg` E NÃO `pre-commit`: a regra depende da mensagem, e no
# `pre-commit` a mensagem ainda não existe. Neste ponto as alterações já estão
# em staging, logo `git diff --cached` vê tudo o que o `pre-commit` veria.
#
# INSTALAÇÃO (uma vez por clone, e é o que o smoke verifica):
#   git config core.hooksPath scripts/hooks
#
# Reduções legítimas existem — dividir um documento, arquivar uma secção. Para
# essas, a palavra `rewrite` na mensagem diz que a perda é deliberada, e fica
# no histórico a dizê-lo.

set -uo pipefail

MSG_FILE="${1:?uso: commit-msg <ficheiro-da-mensagem>}"
LIMITE_PCT=50

grep -qiE '\brewrite\b' "$MSG_FILE" && exit 0

falhas=()
while IFS=$'\t' read -r estado ficheiro; do
  [ "$estado" = "M" ] || continue
  case "$ficheiro" in
    docs/*) ;;
    *) continue ;;
  esac
  antes=$(git show "HEAD:$ficheiro" 2>/dev/null | wc -l)
  [ "${antes:-0}" -gt 0 ] || continue
  depois=$(git show ":$ficheiro" 2>/dev/null | wc -l)
  perdido=$(( (antes - depois) * 100 / antes ))
  if [ "$perdido" -gt "$LIMITE_PCT" ]; then
    falhas+=("  $ficheiro: $antes -> $depois linhas (-${perdido}%)")
  fi
done < <(git diff --cached --name-status)

if [ ${#falhas[@]} -gt 0 ]; then
  {
    echo
    echo "COMMIT RECUSADO — ficheiro(s) de docs/ a perder mais de ${LIMITE_PCT}% das linhas:"
    printf '%s\n' "${falhas[@]}"
    echo
    echo "Se a perda for deliberada (dividir, arquivar, reescrever), põe a palavra"
    echo "'rewrite' na mensagem do commit e explica porquê."
    echo "Se não for, o ficheiro foi escrito por cima sem se olhar para o que lá estava:"
    echo "  git show HEAD:<ficheiro>   # ver o que se perde"
    echo
  } >&2
  exit 1
fi
exit 0
