#!/bin/bash
# commit-msg — a guarda que faltou a 2026-09-23.
#
# Falha o commit se um ficheiro de `docs/` perder mais de metade das linhas,
# for APAGADO, ou for RENOMEADO para fora de `docs/` — a menos que a mensagem
# traga a palavra `rewrite`.
#
# PORQUÊ: nesse dia escrevi `docs/TEST-ACCOUNTS.md` com `cat >` a assumir que
# não existia. Existia — 105 linhas do levantamento de 19/09 sobre o que se
# perde ao desactivar as contas `.test` — e o commit apagou-as. O CLAUDE.md já
# mandava ler antes de escrever; a regra escrita não chegou, e por isso passa a
# haver uma verificação mecânica.
#
# PORQUÊ `commit-msg` E NÃO `pre-commit`: a regra depende da mensagem, e no
# `pre-commit` a mensagem ainda não existe. Neste ponto as alterações já estão
# em staging, logo `git diff --cached` vê tudo o que o `pre-commit` veria.
#
# INSTALAÇÃO (uma vez por clone, e é o que o smoke verifica):
#   git config core.hooksPath scripts/hooks
#
# Reduções legítimas existem — dividir um documento, arquivar uma secção. Para
# essas, a palavra `rewrite` na mensagem diz que a perda é deliberada, e fica
# no histórico a dizê-lo.

set -uo pipefail

MSG_FILE="${1:?uso: commit-msg <ficheiro-da-mensagem>}"
LIMITE_PCT=50

grep -qiE '\brewrite\b' "$MSG_FILE" && exit 0

# Item 78 (2026-09-24): até aqui só as entradas `M` eram avaliadas. Um `git rm
# docs/X.md` (D) e um `git mv docs/X.md fora/X.md` (R) passavam sem verificação
# — e perder um documento inteiro é o caso extremo do que a guarda existe para
# apanhar. Medido num repositório descartável: `git mv -f A B` sobre um B que
# já existe sai como `D A` + `M B`, logo o D também cobre esse caso. O `-M`
# fixa a detecção de renomeações, que não depende da configuração do clone.
#   M  ficheiro            -> compara linhas HEAD vs índice
#   D  ficheiro            -> perda de 100%
#   R  antigo  novo        -> se o novo está fora de docs/: perda de 100%;
#                             senão compara linhas do antigo (HEAD) com o novo
falhas=()
em_docs() { case "$1" in docs/*) return 0 ;; *) return 1 ;; esac; }
avaliar() {  # $1 rótulo, $2 ficheiro em HEAD, $3 linhas depois
  local antes perdido
  antes=$(git show "HEAD:$2" 2>/dev/null | wc -l)
  [ "${antes:-0}" -gt 0 ] || return 0
  perdido=$(( (antes - $3) * 100 / antes ))
  if [ "$perdido" -gt "$LIMITE_PCT" ]; then
    falhas+=("  $1$2: $antes -> $3 linhas (-${perdido}%)")
  fi
}
while IFS=$'\t' read -r estado f1 f2; do
  case "$estado" in
    M)   em_docs "$f1" && avaliar "" "$f1" "$(git show ":$f1" 2>/dev/null | wc -l)" ;;
    D)   em_docs "$f1" && avaliar "apagado: " "$f1" 0 ;;
    R*)  em_docs "$f1" || continue
         if em_docs "$f2"; then
           avaliar "renomeado para $f2: " "$f1" "$(git show ":$f2" 2>/dev/null | wc -l)"
         else
           avaliar "movido para fora de docs/ ($f2): " "$f1" 0
         fi ;;
  esac
done < <(git diff --cached --name-status -M)

if [ ${#falhas[@]} -gt 0 ]; then
  {
    echo
    echo "COMMIT RECUSADO — ficheiro(s) de docs/ a perder mais de ${LIMITE_PCT}% das linhas (ou apagado(s)/movido(s)):"
    printf '%s\n' "${falhas[@]}"
    echo
    echo "Se a perda for deliberada (dividir, arquivar, reescrever), põe a palavra"
    echo "'rewrite' na mensagem do commit e explica porquê."
    echo "Se não for, o ficheiro foi escrito por cima sem se olhar para o que lá estava:"
    echo "  git show HEAD:<ficheiro>   # ver o que se perde"
    echo
  } >&2
  exit 1
fi
exit 0
